# Application
APP_ENV=development
APP_DEBUG=True

# Service port
PORT=8004

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Django backend base URL (order/inventory tools call this)
DJANGO_API_URL=http://localhost:8000

# Tracking service base URL (timeline syncs with tracking checkpoints)
TRACKING_SERVICE_URL=http://localhost:8003

# ============================================================
# Celery — broker + result backend (SHARED Redis)
# ============================================================
# Reuses the same Redis instance as the Django backend (REDIS_URL). On Render's
# free tier there is no managed Redis or separate worker service — the worker
# and beat run alongside the API in one container (see supervisord.conf), and
# Celery points at this shared Redis.
REDIS_URL=redis://localhost:6379
# Broker defaults to REDIS_URL when blank. Results stay OFF to save memory.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ============================================================
# Auth — verify JWT access tokens issued by the Django backend
# JWT_SECRET MUST equal the Django backend's SECRET_KEY.
# ============================================================
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=user_id
REQUIRE_AUTH=True

# ============================================================
# LLM provider — OpenRouter (OpenAI-compatible). Delivery is the platform's
# 3rd AI feature: the LLM reviews/adjusts the rule-based classification.
# Use the SAME LLM_API_KEY as the assistant + tracking bots. Leave blank to
# run on rules only (the LLM layer is skipped gracefully).
# ============================================================
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3.2
LLM_MAX_TOKENS=512
LLM_ENABLED=True
