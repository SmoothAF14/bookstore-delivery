# Application
APP_ENV=development
APP_DEBUG=True

# Service port
PORT=8004

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Django backend base URL (order/inventory tools call this)
DJANGO_API_URL=http://localhost:8000

# Tracking service base URL (timeline syncs with tracking checkpoints)
TRACKING_SERVICE_URL=http://localhost:8003

# ============================================================
# Celery — broker + result backend (Redis)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# Auth — verify JWT access tokens issued by the Django backend
# JWT_SECRET MUST equal the Django backend's SECRET_KEY.
# ============================================================
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=user_id
REQUIRE_AUTH=True
